# Simülasyon için cihaz tanımları örneği — Iterasyon 1 (walking skeleton)
# Gerçek devices.yaml dosyasını bu örnekten oluşturun: cp devices.yaml.example devices.yaml

devices:
  - id: device_001
    type: telescopic_mast_v1
    sensors:
      - name: motor_current
        unit: A
        baseline: 0.5
        noise_std: 0.1
