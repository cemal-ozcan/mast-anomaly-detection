# Bu dosya gerçek değer içermez, sadece hangi değişkenlerin gerektiğini gösterir.
# Gerçek değerler için .env dosyasını oluşturun (asla commit etmeyin).

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Database
DATABASE_PATH=./data/telemetry.db

# Logging
LOG_LEVEL=INFO
